# ============================================
# AFFINE CONFIGURATION
# ============================================

# AFFiNE image tag: stable, beta, or canary
AFFINE_REVISION=stable

# Server configuration
# Set these to your Railway-provided domain
AFFINE_SERVER_HTTPS=true
AFFINE_SERVER_HOST=your-app.up.railway.app
# Or use the full URL instead:
# AFFINE_SERVER_EXTERNAL_URL=https://your-app.up.railway.app

# ============================================
# DATABASE (PostgreSQL with pgvector)
# ============================================

POSTGRES_USER=affine
POSTGRES_PASSWORD=
POSTGRES_DB=affine

# This is constructed automatically from the above
# DATABASE_URL=postgresql://${{postgres.POSTGRES_USER}}:${{postgres.POSTGRES_PASSWORD}}@${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{postgres.POSTGRES_DB}}

# ============================================
# REDIS
# ============================================

# Automatically references the Redis service
# REDIS_SERVER_HOST=${{redis.RAILWAY_PRIVATE_DOMAIN}}

# ============================================
# AI COPILOT (Optional - set one or both)
# ============================================

# --- NVIDIA NIM ---
# Get a key at https://build.nvidia.com/
NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=moonshotai/kimi-k2.5

# --- Google Gemini ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=
# GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# ============================================
# CLOUDFLARE DNS (Optional - custom domain)
# ============================================
# Set these to automatically create a CNAME record
# pointing your custom domain to Railway.
# Requires a Cloudflare API token with DNS edit permissions.

# Cloudflare API token (Zone:DNS:Edit)
# CLOUDFLARE_TOKEN=

# Custom domain for AFFiNE (e.g., affine.yourdomain.com)
# CLOUDFLARE_DOMAIN=

# ============================================
# AFFINE INTERNAL
# ============================================

# Disable indexer (not needed for basic self-hosting)
AFFINE_INDEXER_ENABLED=false
